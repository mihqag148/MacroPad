<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lumi Macropad v1.7.4 · sensor fallback and dark theme -->
  <PropertyGroup>
    <!-- v1.7.4 final verified build -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Lumi Macropad</AssemblyName>
    <RootNamespace>LumiPad.App</RootNamespace>
    <Product>Lumi Macropad</Product>
    <AssemblyTitle>Lumi Macropad</AssemblyTitle>
    <Description>Lumi Macropad multi-product device manager</Description>
    <Version>1.7.4</Version>
    <AssemblyVersion>1.7.4.0</AssemblyVersion>
    <FileVersion>1.7.4.0</FileVersion>
</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.3" />
  </ItemGroup>
</Project>
