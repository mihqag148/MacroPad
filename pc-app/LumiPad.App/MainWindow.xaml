<Window x:Class="LumiPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lumi Macropad" Width="1480" Height="960"
        MinWidth="1080" MinHeight="720"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="#252527"/>
            <Setter Property="BorderBrush" Value="#4A4A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="#252527"
                                BorderBrush="#4A4A4D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,5">
                            <ContentPresenter
                                TextElement.Foreground="#F5F5F7"
                                TextElement.FontFamily="Segoe UI"
                                TextElement.FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="DeviceWorkspace"
              Margin="24"
              Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="← Products"
                        Click="BackToProducts_Click"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="WorkspaceProductTitle"
                               Text="DIAL DESK"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Lumi Macropad · Device Control"
                               Foreground="{DynamicResource Muted}"
                               FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button x:Name="SleepKeyboardButton"
                        Width="38" Height="38"
                        Padding="0"
                        ToolTip="Sleep keyboard"
                        Click="SleepKeyboard_Click"
                        IsEnabled="False"
                        Margin="0">
                    <TextBlock x:Name="SleepKeyboardIcon"
                               Text="⏻"
                               FontFamily="Segoe UI Symbol"
                               FontSize="19"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <Button x:Name="ConnectUsbButton"
                        Width="38" Height="38"
                        Padding="8"
                        ToolTip="USB"
                        Click="ConnectUsbButton_Click"
                        Margin="22,0,8,0">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="HeaderUsbPath"
                                  Stroke="{DynamicResource Muted}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M12,3 L12,16 M12,3 L9,6 M12,3 L15,6 M12,10 L7,10 L7,16 M7,16 L5,16 M12,13 L17,13 L17,9 M17,9 L15,11 M17,9 L19,11"/>
                            <Ellipse x:Name="HeaderUsbDot"
                                     Canvas.Left="10" Canvas.Top="16"
                                     Width="4" Height="4"
                                     Fill="{DynamicResource Muted}"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="ConnectBluetoothButton"
                        Width="38" Height="38"
                        Padding="8"
                        ToolTip="Bluetooth"
                        Click="ConnectBluetoothButton_Click"
                        Margin="0">
                    <Viewbox Width="20" Height="20">
                        <Path x:Name="HeaderBluetoothPath"
                              Stroke="{DynamicResource Muted}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M11,3 L17,8 L11,13 L11,3 M11,13 L17,18 L11,22 L11,13 M11,8 L6,4 M11,17 L6,21"/>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2"
                    SelectionChanged="MainTabs_SelectionChanged">

            <TabItem Header="Home">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.82*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="MEDIA"
                                           FontSize="12"
                                           Foreground="{DynamicResource Muted}"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="SourceText"
                                           Text="MEDIA SESSION"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="138"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Width="138"
                                        Height="138"
                                        CornerRadius="18"
                                        Background="{DynamicResource Card2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="AlbumArtImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <Grid x:Name="AlbumArtFallback">
                                            <Ellipse Width="66" Height="66">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="1,1">
                                                        <GradientStop Color="#FF9500" Offset="0"/>
                                                        <GradientStop Color="#FF2D55" Offset="0.55"/>
                                                        <GradientStop Color="#5856D6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="▶"
                                                       FontSize="24"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Text="Nothing Playing"
                                               FontSize="23"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxHeight="66"/>
                                    <TextBlock x:Name="ArtistText"
                                               Text="Lumi Macropad"
                                               FontSize="14"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,5,0,17"/>

                                    <Slider x:Name="TrackSlider"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="0"
                                            Height="24"
                                            IsMoveToPointEnabled="True"
                                            IsEnabled="False"
                                            PreviewMouseLeftButtonDown="TrackSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="TrackSlider_PreviewMouseLeftButtonUp"
                                            ValueChanged="TrackSlider_ValueChanged"/>

                                    <Grid Margin="1,2,1,0">
                                        <TextBlock x:Name="ElapsedText"
                                                   Text="0:00"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="DurationText"
                                                   Text="-0:00"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="MuteButton"
                                            Content="🔊"
                                            Width="38"
                                            Height="38"
                                            Padding="0"
                                            Click="MuteButton_Click"
                                            ToolTip="Mute / unmute"/>
                                    <Slider x:Name="VolumeSlider"
                                            Width="112"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="50"
                                            IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                    <TextBlock x:Name="VolumeText"
                                               Text="50%"
                                               Width="40"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button x:Name="PrevButton"
                                            Content="◀◀"
                                            Width="42"
                                            Height="38"
                                            Padding="0"
                                            IsEnabled="False"
                                            Click="PrevButton_Click"/>
                                    <Button x:Name="PlayButton"
                                            Content="▶"
                                            Width="48"
                                            Height="42"
                                            Padding="0"
                                            FontSize="17"
                                            IsEnabled="False"
                                            Click="PlayButton_Click"/>
                                    <Button x:Name="NextButton"
                                            Content="▶▶"
                                            Width="42"
                                            Height="38"
                                            Padding="0"
                                            Margin="0"
                                            IsEnabled="False"
                                            Click="NextButton_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ShuffleButton"
                                            Content="🔀"
                                            Width="40"
                                            Height="38"
                                            Padding="0"
                                            IsEnabled="False"
                                            Click="ShuffleButton_Click"
                                            ToolTip="Shuffle"/>
                                    <Button x:Name="RepeatButton"
                                            Content="↻"
                                            Width="48"
                                            Height="38"
                                            Padding="0"
                                            Margin="0"
                                            IsEnabled="False"
                                            Click="RepeatButton_Click"
                                            ToolTip="Repeat"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="SCREENSAVER MEDIA"
                                               FontSize="12"
                                               Foreground="{DynamicResource Muted}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="GIF / Image local"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,7,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="Source"
                                               FontSize="11"
                                               Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ScreensaverSourceCombo"
                                              Width="170"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="ScreensaverSourceCombo_SelectionChanged">
                                        <ComboBoxItem Content="GIF / Image" Tag="Media" IsSelected="True"/>
                                        <ComboBoxItem Content="PC Monitor" Tag="PcMonitor"/>
                                    </ComboBox>
                                    <TextBlock x:Name="ScreensaverSourceHint"
                                               Text="Uploaded media"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Physical DIAL DESK panel is 320x172.
                                 Keep the app preview at exactly the same 1.8605:1
                                 aspect ratio instead of approximating 16:9. -->
                            <Border Width="360"
                                    Height="193.5"
                                    HorizontalAlignment="Center"
                                    Background="#050505"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Grid Width="320" Height="172">
                                    <Image x:Name="ScreensaverPreviewImage"
                                           Stretch="Fill"
                                           Visibility="Collapsed"/>
                                    <TextBlock x:Name="ScreensaverPreviewHint"
                                               Text="320 × 172 · Choose a GIF or image"
                                               Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ScreensaverFileName"
                                       Text="No file selected"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,10,0,0"/>

                            <TextBlock x:Name="ScreensaverMediaInfo"
                                       Text="Converted to a lightweight loop for DIAL DESK."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,4,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Scale"
                                           Width="52"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}"/>
                                <ComboBox x:Name="ScreensaverScaleCombo"
                                          Width="150"
                                          SelectionChanged="ScreensaverScaleCombo_SelectionChanged">
                                    <ComboBoxItem Content="Fill" Tag="Fill" IsSelected="True"/>
                                    <ComboBoxItem Content="Fit" Tag="Fit"/>
                                    <ComboBoxItem Content="Stretch" Tag="Stretch"/>
                                    <ComboBoxItem Content="Tile" Tag="Tile"/>
                                    <ComboBoxItem Content="Center" Tag="Center"/>
                                    <ComboBoxItem Content="Span" Tag="Span"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose GIF / Image"
                                        Click="ChooseScreensaverMedia_Click"/>
                                <Button x:Name="SendScreensaverButton"
                                        Content="Send to DIAL DESK"
                                        Click="SendScreensaverMedia_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="ShowScreensaverNowButton"
                                        Content="Show now"
                                        Click="ShowScreensaverNow_Click"
                                        IsEnabled="False"/>
                                <Button Content="Clear"
                                        Click="ClearScreensaverMedia_Click"
                                        Margin="0"/>
                            </StackPanel>

                            <ProgressBar x:Name="ScreensaverSendProgress"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="5" Margin="0,14,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Ellipse x:Name="ScreensaverUploadDot"
                                         Width="9" Height="9"
                                         Fill="#66666A"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>
                                <TextBlock x:Name="ScreensaverUploadState"
                                           Text="Not uploaded"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="ScreensaverSendStatus"
                                       Text="The file stays local. Only reduced animation frames are sent."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,8,0,0"/>

                            <Border Height="1"
                                    Background="{DynamicResource Line}"
                                    Margin="0,14,0,12"/>

                            <Grid x:Name="DeviceTimingPanel" IsEnabled="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Screensaver after"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ScreensaverDelayCombo"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="ScreensaverDelayCombo_SelectionChanged">
                                        <ComboBoxItem Content="15 seconds" Tag="15"/>
                                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                                        <ComboBoxItem Content="1 minute" Tag="60"/>
                                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sleep after"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="SleepDelayCombo"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="SleepDelayCombo_SelectionChanged">
                                        <ComboBoxItem Content="1 minute" Tag="60"/>
                                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                                        <ComboBoxItem Content="15 minutes" Tag="900"/>
                                        <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>



                </Grid>
            </TabItem>

            <TabItem Header="RGB">
                <Grid Margin="0,14,0,0">
                    <Border x:Name="RgbDevicePanel"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="28"
                            IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COLOR"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                                <Border Width="220" Height="185"
                                        Margin="0,10,0,12"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1">
                                    <Image x:Name="ColorWheelImage"
                                           Width="220" Height="185"
                                           Stretch="Fill"
                                           MouseLeftButtonDown="ColorWheelImage_MouseLeftButtonDown"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="HEX" Width="42" VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <Border Background="{DynamicResource ControlBg}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="9,6"
                                            Width="160">
                                        <TextBlock x:Name="RgbHexText" Text="#FF7800"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RGB" Width="42" VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="R" Foreground="#FF453A" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RgbRText" Text="255" Margin="5,0,10,0"/>
                                    <TextBlock Text="G" Foreground="#30D158" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RgbGText" Text="120" Margin="5,0,10,0"/>
                                    <TextBlock Text="B" Foreground="#0A84FF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RgbBText" Text="0" Margin="5,0,0,0"/>
                                </StackPanel>

                                <WrapPanel Margin="0,18,0,0">
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#FF1A1A" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#FF1A1A" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#D75A5A" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#D75A5A" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#43D17C" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#43D17C" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#FFE24B" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#FFE24B" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#67E7DB" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#67E7DB" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#10B9B9" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#10B9B9" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#A7DF37" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#A7DF37" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#B33AC7" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#B33AC7" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#5DCB48" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#5DCB48" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#FFB812" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#FFB812" Width="24" Height="24"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1"
                                    Background="{DynamicResource Line}"
                                    HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mode"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,20">
                                    <Button Content="Static" Tag="Static"
                                            Click="RgbMode_Click" Width="100"/>
                                    <Button Content="Dynamic" Tag="Dynamic"
                                            Click="RgbMode_Click" Width="100"/>
                                    <Button Content="Reactive" Tag="Reactive"
                                            Click="RgbMode_Click" Width="100"/>
                                </StackPanel>

                                <TextBlock Text="Presets"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14"/>

                                <WrapPanel x:Name="RgbStaticPresets">
                                    <Button Content="Solid Color" Tag="3"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Auto by Layer" Tag="AUTO"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                </WrapPanel>

                                <WrapPanel x:Name="RgbDynamicPresets"
                                           Visibility="Collapsed">
                                    <Button Content="Rainbow" Tag="0"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Purple Ping-Pong" Tag="1"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Orange Blink" Tag="2"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Auto by Layer" Tag="AUTO"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                </WrapPanel>

                                <WrapPanel x:Name="RgbReactivePresets"
                                           Visibility="Collapsed">
                                    <Button Content="Reactive Splash" Tag="4"
                                            Click="RgbPreset_Click"
                                            Width="130" Height="48"/>
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1"
                                    Background="{DynamicResource Line}"
                                    HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RGB Profile"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <ComboBox x:Name="RgbProfileCombo"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="RgbProfileCombo_SelectionChanged"
                                          Margin="0,8,0,8">
