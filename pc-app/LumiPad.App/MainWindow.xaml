<Window x:Class="LumiPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LumiPad" Width="1080" Height="700"
        MinWidth="940" MinHeight="620"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="142" Height="48" CornerRadius="10"
                        Background="Black" Margin="0,0,12,0"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Padding="9,4">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="180" Height="54">
                            <TextBlock Text="Lumi3D"
                                       Foreground="#E8E5E1"
                                       FontFamily="Arial"
                                       FontWeight="Bold"
                                       FontSize="40"
                                       VerticalAlignment="Top"/>
                            <TextBlock Text="ESTD 2025"
                                       Foreground="#E8E5E1"
                                       FontFamily="Arial"
                                       FontWeight="SemiBold"
                                       FontSize="9"
                                       Margin="3,43,0,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LumiPad" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Wireless MacroPad Control"
                               Foreground="{DynamicResource Muted}" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Content="Light mode"
                        Click="ThemeButton_Click" Padding="12,7"/>

                <Border Background="{DynamicResource Card2}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="18" Padding="14,8" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DeviceDot" Width="9" Height="9"
                                 Fill="#66666A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DeviceStatus" Text="Not connected"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2"
                    SelectionChanged="MainTabs_SelectionChanged">

            <TabItem Header="Home">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.82*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="NOW PLAYING" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Width="180" Height="180" CornerRadius="30"
                                        Background="{DynamicResource Card2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="AlbumArtImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <Grid x:Name="AlbumArtFallback">
                                            <Ellipse Width="82" Height="82">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF9500" Offset="0"/>
                                                        <GradientStop Color="#FF2D55" Offset="0.55"/>
                                                        <GradientStop Color="#5856D6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="▶" FontSize="30" Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="Nothing Playing"
                                               FontSize="26" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxHeight="72"/>
                                    <TextBlock x:Name="ArtistText" Text="LumiPad"
                                               FontSize="16"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,8,0,24"/>

                                    <ProgressBar x:Name="TrackProgress"
                                                 Minimum="0" Maximum="1" Value="0"
                                                 Height="5" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 Background="{DynamicResource Line}"/>

                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="ElapsedText" Text="0:00"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="DurationText" Text="0:00"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,26,0,0">
                                <Button x:Name="PrevButton" Content="◀◀" FontSize="18"
                                        Click="PrevButton_Click"/>
                                <Button x:Name="PlayButton" Content="▶" FontSize="18"
                                        Click="PlayButton_Click"/>
                                <Button x:Name="NextButton" Content="▶▶" FontSize="18"
                                        Click="NextButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="26">
                        <StackPanel>
                            <TextBlock Text="DISPLAY" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Smart Now Playing" FontSize="23"
                                       FontWeight="SemiBold" Margin="0,8,0,18"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Text="The music screen only appears while an allowed music source is actively playing. Pressing any macropad key returns to the normal key grid for 10 seconds, then music returns automatically if playback is still active."/>
                            <Border Height="1" Background="{DynamicResource Line}"
                                    Margin="0,22,0,22"/>
                            <TextBlock Text="Supported sources" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,6,0,0"
                                       Text="Spotify · Apple Music · Windows Music · YouTube / YouTube Music in Chrome, Edge, Firefox, Brave or Opera"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="RGB">
                <Grid Margin="0,14,0,0">
                    <Border Width="620" HorizontalAlignment="Left"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="30">
                        <StackPanel>
                            <TextBlock Text="RGB" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="4 × WS2812B" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,8,0,24"/>

                            <CheckBox x:Name="LedEnabled"
                                      Content="RGB Power — On / Off"
                                      IsChecked="True"
                                      Checked="LedEnabled_Changed"
                                      Unchecked="LedEnabled_Changed"
                                      Margin="0,0,0,22"/>

                            <TextBlock Text="Mode"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,7"/>
                            <ComboBox x:Name="EffectCombo"
                                      Width="430" HorizontalAlignment="Left"
                                      SelectionChanged="EffectCombo_SelectionChanged">
                                <ComboBoxItem Content="Auto by Layer" Tag="-1" IsSelected="True"/>
                                <ComboBoxItem Content="Rainbow" Tag="0"/>
                                <ComboBoxItem Content="Warm Purple Ping-Pong" Tag="1"/>
                                <ComboBoxItem Content="Orange Blink" Tag="2"/>
                                <ComboBoxItem Content="Solid Color" Tag="3"/>
                            </ComboBox>

                            <Grid Margin="0,26,0,0" Width="430" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="BrightnessText"
                                           Grid.Column="1" Text="25%"/>
                            </Grid>

                            <Slider x:Name="BrightnessSlider"
                                    Minimum="5" Maximum="50" Value="25"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="BrightnessSlider_ValueChanged"
                                    Width="430" HorizontalAlignment="Left"
                                    Margin="0,8,0,26"/>

                            <TextBlock Text="Solid color"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ColorPreview" Width="58" Height="38"
                                        CornerRadius="10" Background="#FF7800"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1" Margin="0,0,12,0"/>
                                <Button Content="Choose color"
                                        Click="ChooseColor_Click"/>
                            </StackPanel>

                            <TextBlock Text="All RGB changes are sent directly to the macropad over Bluetooth when available."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="12" Margin="0,28,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Customize">
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="28" Padding="28">
                            <StackPanel>
                                <TextBlock Text="DISPLAY CUSTOMIZE" FontSize="12"
                                           Foreground="{DynamicResource Muted}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Wallpaper &amp; Screensaver"
                                           FontSize="25" FontWeight="SemiBold"
                                           Margin="0,8,0,24"/>

                                <TextBlock Text="Main menu wallpaper"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Choose a preset or make a two-color gradient."
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12" Margin="0,4,0,8"/>
                                <ComboBox x:Name="WallpaperPresetCombo"
                                          Width="430" HorizontalAlignment="Left"
                                          SelectionChanged="WallpaperPresetCombo_SelectionChanged">
                                    <ComboBoxItem Content="Midnight" Tag="midnight" IsSelected="True"/>
                                    <ComboBoxItem Content="Ocean" Tag="ocean"/>
                                    <ComboBoxItem Content="Purple" Tag="purple"/>
                                    <ComboBoxItem Content="Sunset" Tag="sunset"/>
                                    <ComboBoxItem Content="Custom colors" Tag="custom"/>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,26">
                                    <Border x:Name="WallpaperColorAPreview"
                                            Width="58" Height="38" CornerRadius="10"
                                            Background="#000000"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" Margin="0,0,8,0"/>
                                    <Button Content="Color A"
                                            Click="WallpaperColorA_Click"/>
                                    <Border x:Name="WallpaperColorBPreview"
                                            Width="58" Height="38" CornerRadius="10"
                                            Background="#10151F"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" Margin="8,0,8,0"/>
                                    <Button Content="Color B"
                                            Click="WallpaperColorB_Click"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Line}"
                                        Margin="0,0,0,24"/>

                                <TextBlock Text="Screensaver" FontWeight="SemiBold"/>
                                <TextBlock Text="Tahoe Motion uses moving glass and two customizable glow colors."
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Margin="0,4,0,8"/>
                                <ComboBox x:Name="ScreensaverStyleCombo"
                                          Width="430" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Tahoe Motion" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="Minimal" Tag="1"/>
                                    <ComboBoxItem Content="Off" Tag="2"/>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,20">
                                    <Border x:Name="SaverColorAPreview"
                                            Width="58" Height="38" CornerRadius="10"
                                            Background="#4A7DFF"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" Margin="0,0,8,0"/>
                                    <Button Content="Glow A"
                                            Click="SaverColorA_Click"/>
                                    <Border x:Name="SaverColorBPreview"
                                            Width="58" Height="38" CornerRadius="10"
                                            Background="#A955FF"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" Margin="8,0,8,0"/>
                                    <Button Content="Glow B"
                                            Click="SaverColorB_Click"/>
                                </StackPanel>

                                <Grid Width="430" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Screensaver after"
                                                   Foreground="{DynamicResource Muted}"
                                                   Margin="0,0,0,6"/>
                                        <ComboBox x:Name="ScreensaverDelayCombo">
                                            <ComboBoxItem Content="30 seconds" Tag="30"/>
                                            <ComboBoxItem Content="1 minute" Tag="60" IsSelected="True"/>
                                            <ComboBoxItem Content="2 minutes" Tag="120"/>
                                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sleep after"
                                                   Foreground="{DynamicResource Muted}"
                                                   Margin="0,0,0,6"/>
                                        <ComboBox x:Name="SleepDelayCombo">
                                            <ComboBoxItem Content="2 minutes" Tag="120" IsSelected="True"/>
                                            <ComboBoxItem Content="5 minutes" Tag="300"/>
                                            <ComboBoxItem Content="10 minutes" Tag="600"/>
                                            <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                            <ComboBoxItem Content="Never" Tag="0"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Button Content="Apply to LumiPad"
                                        Width="170" HorizontalAlignment="Left"
                                        Margin="0,26,0,0"
                                        Click="ApplyCustomization_Click"/>

                                <TextBlock Text="Connected sleep turns the screen black and pauses RGB but keeps Bluetooth alive, so music or any key can wake LumiPad instantly."
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="28" Padding="28">
                            <StackPanel>
                                <TextBlock Text="PREVIEW" FontSize="12"
                                           Foreground="{DynamicResource Muted}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Macropad display"
                                           FontSize="22" FontWeight="SemiBold"
                                           Margin="0,8,0,20"/>

                                <Border Width="480" Height="258"
                                        HorizontalAlignment="Center"
                                        Background="#05070B"
                                        CornerRadius="30"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        Padding="18">
                                    <Border x:Name="DisplayPreview"
                                            CornerRadius="18"
                                            BorderBrush="#55FFFFFF"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush x:Name="DisplayPreviewBrush"
                                                                 StartPoint="0,0"
                                                                 EndPoint="0,1">
                                                <GradientStop x:Name="PreviewStopA"
                                                              Color="#000000" Offset="0"/>
                                                <GradientStop x:Name="PreviewStopB"
                                                              Color="#10151F" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid>
                                            <TextBlock Text="LumiPad"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="White"
                                                       FontSize="28"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Wallpaper preview"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#B8FFFFFF"
                                                       FontSize="12"
                                                       Margin="0,54,0,0"/>
                                        </Grid>
                                    </Border>
                                </Border>

                                <TextBlock Text="Settings are stored by the Windows app and sent again automatically after LumiPad wakes or reconnects."
                                           Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap" FontSize="12"
                                           Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ZmkTab" Header="ZMK Studio">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource Card2}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="18" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ZMK Studio"
                                           FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Name="ZmkStatus"
                                           Text="Embedded zmk.studio"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Reload" Click="ReloadZmk_Click"/>
                                <Button Content="Open in Edge"
                                        Click="OpenZmkExternal_Click" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="18"
                            ClipToBounds="True">
                        <wv2:WebView2 x:Name="ZmkWebView"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4"
                Background="{DynamicResource Card2}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                CornerRadius="18" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="BottomStatus"
                           Text="Bluetooth is preferred automatically; USB remains as a fallback."
                           Foreground="{DynamicResource Muted}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="DetectButton" Content="Detect LumiPad"
                            Click="DetectButton_Click"/>
                    <Button Content="Disconnect"
                            Click="DisconnectButton_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
