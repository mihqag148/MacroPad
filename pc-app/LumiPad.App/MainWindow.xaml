<Window x:Class="LumiPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LumiPad" Width="1080" Height="700"
        MinWidth="940" MinHeight="620"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="142" Height="48" CornerRadius="10"
                        Background="Black" Margin="0,0,12,0"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Padding="9,4">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="180" Height="54">
                            <TextBlock Text="Lumi3D"
                                       Foreground="#E8E5E1"
                                       FontFamily="Arial"
                                       FontWeight="Bold"
                                       FontSize="40"
                                       VerticalAlignment="Top"/>
                            <TextBlock Text="ESTD 2025"
                                       Foreground="#E8E5E1"
                                       FontFamily="Arial"
                                       FontWeight="SemiBold"
                                       FontSize="9"
                                       Margin="3,43,0,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LumiPad" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Wireless MacroPad Control"
                               Foreground="{DynamicResource Muted}" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ThemeButton" Content="Light mode"
                            Click="ThemeButton_Click" Padding="12,7"/>
                    <Button x:Name="DetectButton" Content="Detect LumiPad"
                            Click="DetectButton_Click" Padding="12,7"/>
                    <Button Content="Disconnect"
                            Click="DisconnectButton_Click" Padding="12,7" Margin="0"/>

                    <Border Background="{DynamicResource Card2}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="18" Padding="14,8" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceDot" Width="9" Height="9"
                                     Fill="#66666A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DeviceStatus" Text="Not connected"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="BottomStatus"
                           Text="Bluetooth preferred; USB fallback."
                           Foreground="{DynamicResource Muted}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2"
                    SelectionChanged="MainTabs_SelectionChanged">

            <TabItem Header="Home">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.82*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="NOW PLAYING" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Width="180" Height="180" CornerRadius="30"
                                        Background="{DynamicResource Card2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="AlbumArtImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <Grid x:Name="AlbumArtFallback">
                                            <Ellipse Width="82" Height="82">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF9500" Offset="0"/>
                                                        <GradientStop Color="#FF2D55" Offset="0.55"/>
                                                        <GradientStop Color="#5856D6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="▶" FontSize="30" Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="Nothing Playing"
                                               FontSize="26" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxHeight="72"/>
                                    <TextBlock x:Name="ArtistText" Text="LumiPad"
                                               FontSize="16"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,8,0,24"/>

                                    <ProgressBar x:Name="TrackProgress"
                                                 Minimum="0" Maximum="1" Value="0"
                                                 Height="5" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 Background="{DynamicResource Line}"/>

                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="ElapsedText" Text="0:00"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="DurationText" Text="0:00"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,26,0,0">
                                <Button x:Name="PrevButton" Content="◀◀" FontSize="18"
                                        Click="PrevButton_Click"/>
                                <Button x:Name="PlayButton" Content="▶" FontSize="18"
                                        Click="PlayButton_Click"/>
                                <Button x:Name="NextButton" Content="▶▶" FontSize="18"
                                        Click="NextButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="22">
                        <StackPanel>
                            <TextBlock Text="SCREENSAVER MEDIA" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="GIF / MP4 local" FontSize="22"
                                       FontWeight="SemiBold" Margin="0,7,0,12"/>

                            <Border Height="150"
                                    Background="#050505"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ScreensaverPreviewImage"
                                           Stretch="Uniform"
                                           Visibility="Collapsed"/>
                                    <TextBlock x:Name="ScreensaverPreviewHint"
                                               Text="Choose a GIF or MP4"
                                               Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ScreensaverFileName"
                                       Text="No file selected"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,10,0,0"/>

                            <TextBlock x:Name="ScreensaverMediaInfo"
                                       Text="Converted to a lightweight loop for LumiPad."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,4,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose GIF / MP4"
                                        Click="ChooseScreensaverMedia_Click"/>
                                <Button x:Name="SendScreensaverButton"
                                        Content="Send to LumiPad"
                                        Click="SendScreensaverMedia_Click"
                                        IsEnabled="False"/>
                                <Button Content="Clear"
                                        Click="ClearScreensaverMedia_Click"
                                        Margin="0"/>
                            </StackPanel>

                            <ProgressBar x:Name="ScreensaverSendProgress"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="5" Margin="0,14,0,0"/>

                            <TextBlock x:Name="ScreensaverSendStatus"
                                       Text="The file stays local. Only reduced animation frames are sent."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

            <TabItem Header="RGB">
                <Grid Margin="0,14,0,0">
                    <Border Width="720" HorizontalAlignment="Left"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="30">
                        <StackPanel>
                            <TextBlock Text="RGB" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="4 × WS2812B" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,8,0,24"/>

                            <CheckBox x:Name="LedEnabled"
                                      Content="RGB Power — On / Off"
                                      IsChecked="True"
                                      Checked="LedEnabled_Changed"
                                      Unchecked="LedEnabled_Changed"
                                      Margin="0,0,0,22"/>

                            <TextBlock Text="Mode"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,7"/>
                            <ComboBox x:Name="EffectCombo"
                                      Width="430" HorizontalAlignment="Left"
                                      SelectionChanged="EffectCombo_SelectionChanged">
                                <ComboBoxItem Content="Auto by Layer" Tag="-1" IsSelected="True"/>
                                <ComboBoxItem Content="Rainbow" Tag="0"/>
                                <ComboBoxItem Content="Warm Purple Ping-Pong" Tag="1"/>
                                <ComboBoxItem Content="Orange Blink" Tag="2"/>
                                <ComboBoxItem Content="Solid Color" Tag="3"/>
                            </ComboBox>

                            <Grid Margin="0,26,0,0" Width="430" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Brightness"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBlock x:Name="BrightnessText"
                                           Grid.Column="1" Text="25%"/>
                            </Grid>

                            <Slider x:Name="BrightnessSlider"
                                    Minimum="5" Maximum="50" Value="25"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="BrightnessSlider_ValueChanged"
                                    Width="430" HorizontalAlignment="Left"
                                    Margin="0,8,0,26"/>

                            <TextBlock Text="Solid color"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <Border x:Name="ColorPreview" Width="58" Height="38"
                                            CornerRadius="10" Background="#FF7800"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1" Margin="0,0,0,10"/>
                                    <Button Content="Choose color"
                                            Click="ChooseColor_Click" Margin="0"/>
                                </StackPanel>

                                <Grid Width="148" Height="148" Margin="28,0,0,0"
                                      ToolTip="Click the color wheel to choose RGB color">
                                    <Image x:Name="ColorWheelImage"
                                           Width="148" Height="148"
                                           Stretch="None"
                                           MouseLeftButtonDown="ColorWheelImage_MouseLeftButtonDown"/>
                                    <Ellipse x:Name="ColorWheelCursor"
                                             Width="12" Height="12"
                                             Stroke="White" StrokeThickness="2"
                                             Fill="#22000000"
                                             IsHitTestVisible="False"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="All RGB changes are sent directly to the macropad over Bluetooth when available."
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="12" Margin="0,28,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ZmkTab" Header="ZMK Studio">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource Card2}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="18" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ZMK Studio"
                                           FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Name="ZmkStatus"
                                           Text="Embedded zmk.studio"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Reload" Click="ReloadZmk_Click"/>
                                <Button Content="Open in Edge"
                                        Click="OpenZmkExternal_Click" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="18"
                            ClipToBounds="True">
                        <wv2:WebView2 x:Name="ZmkWebView"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>


    </Grid>
</Window>
