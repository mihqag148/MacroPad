                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="GPU"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="PcGpuLoadText"
                                               Text="--%"
                                               FontSize="42"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,0"/>
                                    <TextBlock x:Name="PcGpuNameText"
                                               Text="--"
                                               Foreground="{DynamicResource Accent}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Temperature"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="PcGpuTempText"
                                                   Grid.Column="1"
                                                   Text="-- °C"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Core clock"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="PcGpuClockText"
                                                   Grid.Column="1"
                                                   Text="-- MHz"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="MEMORY"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="PcRamLoadText"
                                               Text="--%"
                                               FontSize="42"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,0"/>
                                    <TextBlock x:Name="PcRamDetailText"
                                               Text="-- / -- GB"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="14"
                                               Margin="0,18,0,0"/>
                                    <TextBlock x:Name="PcFpsText"
                                               Text="FPS --"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="8"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DOWNLOAD"
                                               FontSize="11"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="PcNetDownText"
                                               Text="0.0 Mbps"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="UPLOAD"
                                               FontSize="11"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock x:Name="PcNetUpText"
                                               Text="0.0 Mbps"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="GPU selection"
                                               FontSize="11"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="Auto follows the GPU with the highest realtime load. Choose a GPU manually if you want to pin monitoring to a specific card."
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="DEVICE"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="DIAL DESK status"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,18"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Firmware"/>
                                        <TextBlock x:Name="FirmwareVersionText"
                                                   Grid.Column="1"
                                                   Text="--"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>

                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Connection"/>
                                        <TextBlock x:Name="ConnectionInfoText"
                                                   Grid.Column="1"
                                                   Text="Disconnected"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>

                                    <Border Background="{DynamicResource Card2}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,14,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="DeviceDot"
                                                             Width="9"
                                                             Height="9"
                                                             Fill="#66666A"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="DeviceStatus"
                                                               Text="Not connected"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="BottomStatus"
                                                           Text="Auto connect · USB first · Bluetooth fallback"
                                                           Foreground="{DynamicResource Muted}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="17,4,8,0"/>
                                            </StackPanel>

                                            <Button x:Name="DisconnectButton"
                                                    Grid.Column="1"
                                                    Content="Disconnect"
                                                    Click="DisconnectButton_Click"
                                                    IsEnabled="False"
                                                    Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="Deep sleep after"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,18,0,6"/>
                                    <ComboBox x:Name="DeepSleepDelayCombo"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="DeepSleepDelayCombo_SelectionChanged">
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                                        <ComboBoxItem Content="15 minutes" Tag="900"/>
                                        <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                        <ComboBoxItem Content="1 hour" Tag="3600"/>
                                        <ComboBoxItem Content="2 hours" Tag="7200"/>
                                    </ComboBox>
                                    <TextBlock Text="Deep sleep disconnects Bluetooth and uses very little power. Press a key to reboot and reconnect."
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>

                                    <Border Height="1"
                                            Background="{DynamicResource Line}"
                                            Margin="0,20,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="UPDATES"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Muted}"/>
                                            <TextBlock Text="One-click updates"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="CheckUpdatesButton"
                                                Grid.Column="1"
                                                Content="Check now"
                                                Click="CheckUpdates_Click"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"/>
                                    </Grid>

                                    <TextBlock x:Name="UpdateStatusText"
                                               Text="Checking for updates…"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,12"/>

                                    <Border Background="{DynamicResource Card2}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="LumiPad app"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="AppUpdateVersionText"
                                                           Text="Current -- · Latest --"
                                                           Foreground="{DynamicResource Muted}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock x:Name="AppUpdateStateText"
                                                           Text="Checking…"
                                                           Foreground="{DynamicResource Muted}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="AppUpdateButton"
                                                    Grid.Column="1"
                                                    Content="Update app"
                                                    Click="AppUpdate_Click"
                                                    IsEnabled="False"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource Card2}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Keyboard firmware"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="FirmwareUpdateVersionText"
                                                           Text="Current -- · Latest --"
                                                           Foreground="{DynamicResource Muted}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"/>
                                                <TextBlock x:Name="FirmwareUpdateStateText"
                                                           Text="Checking…"
                                                           Foreground="{DynamicResource Muted}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="FirmwareUpdateButton"
                                                    Grid.Column="1"
                                                    Content="Update firmware"
                                                    Click="FirmwareUpdate_Click"
                                                    IsEnabled="False"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,16,0,0">
                                        <Button x:Name="RestartKeyboardButton"
                                                Content="Restart keyboard"
                                                Click="RestartKeyboard_Click"
                                                IsEnabled="False"/>
                                        <Button x:Name="KeyboardDfuButton"
                                                Content="Keyboard DFU"
                                                Click="KeyboardDfu_Click"
                                                IsEnabled="False"
                                                Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="22"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="GENERAL"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="App settings"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,18"/>

                                    <TextBlock Text="Language"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="LanguageCombo"
                                              SelectionChanged="LanguageCombo_SelectionChanged"
                                              Margin="0,0,0,16">
                                        <ComboBoxItem Content="EN  English" Tag="en" IsSelected="True"/>
                                        <ComboBoxItem Content="VI  Tiếng Việt" Tag="vi"/>
                                    </ComboBox>

                                    <TextBlock Text="Appearance"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <Button x:Name="ThemeButton"
                                            Content="Light mode"
                                            Click="ThemeButton_Click"
                                            HorizontalAlignment="Left"
                                            Margin="0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="22"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="SYSTEM"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="Device information"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,18"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Lumi Macropad"/>
                                        <TextBlock x:Name="AppVersionText"
                                                   Grid.Column="1"
                                                   Text="--"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Flash usage"/>
                                        <TextBlock x:Name="FlashUsageText"
                                                   Grid.Column="1"
                                                   Text="FLASH --"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>

                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="RAM usage"/>
                                        <TextBlock x:Name="RamUsageText"
                                                   Grid.Column="1"
                                                   Text="RAM --"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>

                                    <TextBlock Text="Display"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,18,0,6"/>
                                    <Border Background="{DynamicResource ControlBg}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10">
                                        <TextBlock x:Name="PanelInfoText"
                                                   Text="ST7789 · ~60 Hz default · SPI 32 MHz · GIF max 25 FPS"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="Diagnostic log"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,18,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ViewLogButton"
                                                Content="View log"
                                                Click="ToggleLog_Click"/>
                                        <Button Content="Save log"
                                                Click="SaveLog_Click"
                                                Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="SHOP &amp; SUPPORT"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="Lumi3D"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Phone"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="096 527 6752"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Shopee"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <Button Grid.Column="1"
                                                Content="shopee.vn/lumi3d.hn"
                                                Click="OpenShopee_Click"
                                                HorizontalAlignment="Left"
                                                Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>


        </Grid>

        <Grid x:Name="ProductHub"
              Background="{DynamicResource Bg}">
            <Grid Margin="34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lumi Macropad"
                                       FontSize="27"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Choose a product"
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="ProductHubVersionText"
                                   Text="v--"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="12"/>
                        <TextBlock Text="Product Hub"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="ProductCardsPanel"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ScrollViewer>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProductHubStatusText"
                               Text="Searching for Lumi devices…"
                               Foreground="{DynamicResource Muted}"
                               FontSize="12"/>
                    <TextBlock Grid.Column="1"
                               Text="Lumi3D · Multi-product device manager"
                               Foreground="{DynamicResource Muted}"
                               FontSize="11"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
