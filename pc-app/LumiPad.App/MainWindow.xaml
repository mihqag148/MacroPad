<Window x:Class="LumiPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LumiPad" Width="1480" Height="960"
        MinWidth="1080" MinHeight="720"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="#252527"/>
            <Setter Property="BorderBrush" Value="#4A4A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="#252527"
                                BorderBrush="#4A4A4D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,5">
                            <ContentPresenter
                                TextElement.Foreground="#F5F5F7"
                                TextElement.FontFamily="Segoe UI"
                                TextElement.FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="142" Height="48" CornerRadius="10"
                        Background="Black" Margin="0,0,12,0"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Padding="9,4">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="180" Height="54">
                            <TextBlock Text="Lumi3D"
                                       Foreground="#E8E5E1"
                                       FontFamily="Arial"
                                       FontWeight="Bold"
                                       FontSize="40"
                                       VerticalAlignment="Top"/>
                            <TextBlock Text="ESTD 2025"
                                       Foreground="#E8E5E1"
                                       FontFamily="Arial"
                                       FontWeight="SemiBold"
                                       FontSize="9"
                                       Margin="3,43,0,0"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Viewbox>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LumiPad" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Wireless MacroPad Control"
                               Foreground="{DynamicResource Muted}" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button x:Name="SleepKeyboardButton"
                        Width="38" Height="38"
                        Padding="0"
                        ToolTip="Sleep keyboard"
                        Click="SleepKeyboard_Click"
                        IsEnabled="False"
                        Margin="0">
                    <TextBlock x:Name="SleepKeyboardIcon"
                               Text="⏻"
                               FontFamily="Segoe UI Symbol"
                               FontSize="19"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <Button x:Name="ConnectUsbButton"
                        Width="38" Height="38"
                        Padding="8"
                        ToolTip="USB"
                        Click="ConnectUsbButton_Click"
                        Margin="22,0,8,0">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="HeaderUsbPath"
                                  Stroke="{DynamicResource Muted}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M12,3 L12,16 M12,3 L9,6 M12,3 L15,6 M12,10 L7,10 L7,16 M7,16 L5,16 M12,13 L17,13 L17,9 M17,9 L15,11 M17,9 L19,11"/>
                            <Ellipse x:Name="HeaderUsbDot"
                                     Canvas.Left="10" Canvas.Top="16"
                                     Width="4" Height="4"
                                     Fill="{DynamicResource Muted}"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="ConnectBluetoothButton"
                        Width="38" Height="38"
                        Padding="8"
                        ToolTip="Bluetooth"
                        Click="ConnectBluetoothButton_Click"
                        Margin="0">
                    <Viewbox Width="20" Height="20">
                        <Path x:Name="HeaderBluetoothPath"
                              Stroke="{DynamicResource Muted}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M11,3 L17,8 L11,13 L11,3 M11,13 L17,18 L11,22 L11,13 M11,8 L6,4 M11,17 L6,21"/>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2"
                    SelectionChanged="MainTabs_SelectionChanged">

            <TabItem Header="Home">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.82*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="NOW PLAYING" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Width="180" Height="180" CornerRadius="30"
                                        Background="{DynamicResource Card2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="AlbumArtImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <Grid x:Name="AlbumArtFallback">
                                            <Ellipse Width="82" Height="82">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF9500" Offset="0"/>
                                                        <GradientStop Color="#FF2D55" Offset="0.55"/>
                                                        <GradientStop Color="#5856D6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="▶" FontSize="30" Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="Nothing Playing"
                                               FontSize="26" FontWeight="SemiBold"
                                               TextWrapping="Wrap" MaxHeight="72"/>
                                    <TextBlock x:Name="ArtistText" Text="LumiPad"
                                               FontSize="16"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,8,0,24"/>

                                    <ProgressBar x:Name="TrackProgress"
                                                 Minimum="0" Maximum="1" Value="0"
                                                 Height="5" BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 Background="{DynamicResource Line}"/>

                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="ElapsedText" Text="0:00"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="DurationText" Text="0:00"
                                                   HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,26,0,0">
                                <Button x:Name="PrevButton" Content="◀◀" FontSize="18"
                                        Click="PrevButton_Click"/>
                                <Button x:Name="PlayButton" Content="▶" FontSize="18"
                                        Click="PlayButton_Click"/>
                                <Button x:Name="NextButton" Content="▶▶" FontSize="18"
                                        Click="NextButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="SCREENSAVER MEDIA" FontSize="12"
                                       Foreground="{DynamicResource Muted}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="GIF / Image local" FontSize="22"
                                       FontWeight="SemiBold" Margin="0,7,0,12"/>

                            <Border Height="150"
                                    Background="#050505"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ScreensaverPreviewImage"
                                           Stretch="Uniform"
                                           Visibility="Collapsed"/>
                                    <TextBlock x:Name="ScreensaverPreviewHint"
                                               Text="Choose a GIF or image"
                                               Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ScreensaverFileName"
                                       Text="No file selected"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,10,0,0"/>

                            <TextBlock x:Name="ScreensaverMediaInfo"
                                       Text="Converted to a lightweight loop for LumiPad."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,4,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Scale"
                                           Width="52"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}"/>
                                <ComboBox x:Name="ScreensaverScaleCombo"
                                          Width="150"
                                          SelectionChanged="ScreensaverScaleCombo_SelectionChanged">
                                    <ComboBoxItem Content="Fill" Tag="Fill" IsSelected="True"/>
                                    <ComboBoxItem Content="Fit" Tag="Fit"/>
                                    <ComboBoxItem Content="Stretch" Tag="Stretch"/>
                                    <ComboBoxItem Content="Tile" Tag="Tile"/>
                                    <ComboBoxItem Content="Center" Tag="Center"/>
                                    <ComboBoxItem Content="Span" Tag="Span"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose GIF / Image"
                                        Click="ChooseScreensaverMedia_Click"/>
                                <Button x:Name="SendScreensaverButton"
                                        Content="Send to LumiPad"
                                        Click="SendScreensaverMedia_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="ShowScreensaverNowButton"
                                        Content="Show now"
                                        Click="ShowScreensaverNow_Click"
                                        IsEnabled="False"/>
                                <Button Content="Clear"
                                        Click="ClearScreensaverMedia_Click"
                                        Margin="0"/>
                            </StackPanel>

                            <ProgressBar x:Name="ScreensaverSendProgress"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="5" Margin="0,14,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Ellipse x:Name="ScreensaverUploadDot"
                                         Width="9" Height="9"
                                         Fill="#66666A"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>
                                <TextBlock x:Name="ScreensaverUploadState"
                                           Text="Not uploaded"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="ScreensaverSendStatus"
                                       Text="The file stays local. Only reduced animation frames are sent."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,8,0,0"/>

                            <Border Height="1"
                                    Background="{DynamicResource Line}"
                                    Margin="0,14,0,12"/>

                            <Grid x:Name="DeviceTimingPanel" IsEnabled="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Screensaver after"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ScreensaverDelayCombo"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="ScreensaverDelayCombo_SelectionChanged">
                                        <ComboBoxItem Content="15 seconds" Tag="15"/>
                                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                                        <ComboBoxItem Content="1 minute" Tag="60"/>
                                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sleep after"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="SleepDelayCombo"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="SleepDelayCombo_SelectionChanged">
                                        <ComboBoxItem Content="1 minute" Tag="60"/>
                                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                                        <ComboBoxItem Content="15 minutes" Tag="900"/>
                                        <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>



                </Grid>
            </TabItem>

            <TabItem Header="RGB">
                <Grid Margin="0,14,0,0">
                    <Border x:Name="RgbDevicePanel"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="28"
                            IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="330"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COLOR"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                                <Border Width="220" Height="185"
                                        Margin="0,10,0,12"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1">
                                    <Image x:Name="ColorWheelImage"
                                           Width="220" Height="185"
                                           Stretch="Fill"
                                           MouseLeftButtonDown="ColorWheelImage_MouseLeftButtonDown"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="HEX" Width="42" VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <Border Background="{DynamicResource ControlBg}"
                                            BorderBrush="{DynamicResource Line}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="9,6"
                                            Width="160">
                                        <TextBlock x:Name="RgbHexText" Text="#FF7800"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="RGB" Width="42" VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="R" Foreground="#FF453A" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RgbRText" Text="255" Margin="5,0,10,0"/>
                                    <TextBlock Text="G" Foreground="#30D158" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RgbGText" Text="120" Margin="5,0,10,0"/>
                                    <TextBlock Text="B" Foreground="#0A84FF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RgbBText" Text="0" Margin="5,0,0,0"/>
                                </StackPanel>

                                <WrapPanel Margin="0,18,0,0">
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#FF1A1A" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#FF1A1A" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#D75A5A" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#D75A5A" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#43D17C" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#43D17C" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#FFE24B" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#FFE24B" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#67E7DB" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#67E7DB" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#10B9B9" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#10B9B9" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#A7DF37" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#A7DF37" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#B33AC7" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#B33AC7" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#5DCB48" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#5DCB48" Width="24" Height="24"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Margin="0,0,10,10"
                                            Tag="#FFB812" Click="RgbSwatch_Click">
                                        <Ellipse Fill="#FFB812" Width="24" Height="24"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1"
                                    Background="{DynamicResource Line}"
                                    HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mode"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,20">
                                    <Button Content="Static" Tag="Static"
                                            Click="RgbMode_Click" Width="100"/>
                                    <Button Content="Dynamic" Tag="Dynamic"
                                            Click="RgbMode_Click" Width="100"/>
                                    <Button Content="Reactive" Tag="Reactive"
                                            Click="RgbMode_Click" Width="100"/>
                                </StackPanel>

                                <TextBlock Text="Presets"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,14"/>

                                <WrapPanel x:Name="RgbStaticPresets">
                                    <Button Content="Solid Color" Tag="3"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Auto by Layer" Tag="AUTO"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                </WrapPanel>

                                <WrapPanel x:Name="RgbDynamicPresets"
                                           Visibility="Collapsed">
                                    <Button Content="Rainbow" Tag="0"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Purple Ping-Pong" Tag="1"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Orange Blink" Tag="2"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                    <Button Content="Auto by Layer" Tag="AUTO"
                                            Click="RgbPreset_Click"
                                            Width="120" Height="48"/>
                                </WrapPanel>

                                <WrapPanel x:Name="RgbReactivePresets"
                                           Visibility="Collapsed">
                                    <Button Content="Reactive Splash" Tag="4"
                                            Click="RgbPreset_Click"
                                            Width="130" Height="48"/>
                                </WrapPanel>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1"
                                    Background="{DynamicResource Line}"
                                    HorizontalAlignment="Center"/>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="RGB Profile"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <ComboBox x:Name="RgbProfileCombo"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="RgbProfileCombo_SelectionChanged"
                                          Margin="0,8,0,8">
                                    <ComboBoxItem Content="OFFICE" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="MEDIA" Tag="1"/>
                                    <ComboBoxItem Content="FUSION 360" Tag="2"/>
                                    <ComboBoxItem Content="CUSTOM 4" Tag="3"/>
                                    <ComboBoxItem Content="CUSTOM 5" Tag="4"/>
                                </ComboBox>
                                <Button Content="Save to profile"
                                        Click="RgbSaveProfile_Click"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,18"/>

                                <Border Height="1"
                                        Background="{DynamicResource Line}"
                                        Margin="0,0,0,18"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Switch"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <CheckBox x:Name="LedEnabled"
                                              Grid.Column="1"
                                              IsChecked="True"
                                              Checked="LedEnabled_Changed"
                                              Unchecked="LedEnabled_Changed"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Brightness"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,28,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BrightnessSlider"
                                            Minimum="5" Maximum="50" Value="25"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="BrightnessSlider_ValueChanged"/>
                                    <TextBlock x:Name="BrightnessText"
                                               Grid.Column="1"
                                               Text="25%"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Effect Speed"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,30,0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="RgbSpeedSlider"
                                            Minimum="10" Maximum="100" Value="50"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="RgbSpeedSlider_ValueChanged"/>
                                    <TextBlock x:Name="RgbSpeedText"
                                               Grid.Column="1"
                                               Text="50%"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1"
                                        Background="{DynamicResource Line}"
                                        Margin="0,30,0,20"/>

                                <TextBlock Text="Selected color"
                                           Foreground="{DynamicResource Muted}"/>
                                <Border x:Name="ColorPreview"
                                        Width="72" Height="42"
                                        CornerRadius="10"
                                        Background="#FF7800"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>



            <TabItem Header="Auto Profile">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="AUTO PROFILE"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="Link Game/App"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                    <TextBlock x:Name="AutoProfileStatusText"
                                               Text="Watching active application"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoProfileEnabledCheckBox"
                                          Grid.Column="1"
                                          Content="Enabled"
                                          VerticalAlignment="Center"
                                          Checked="AutoProfileEnabled_Changed"
                                          Unchecked="AutoProfileEnabled_Changed"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <ComboBox x:Name="AutoProfileDefaultCombo"
                                          Grid.Column="1"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="AutoProfileDefaultCombo_SelectionChanged">
                                    <ComboBoxItem Content="OFFICE" Tag="0" IsSelected="True"/>
                                    <ComboBoxItem Content="MEDIA" Tag="1"/>
                                    <ComboBoxItem Content="FUSION 360" Tag="2"/>
                                    <ComboBoxItem Content="CUSTOM 4" Tag="3"/>
                                    <ComboBoxItem Content="CUSTOM 5" Tag="4"/>
                                </ComboBox>
                                <TextBlock Grid.Column="3"
                                           Text="Choose an EXE or add one from the running-app suggestions."
                                           Foreground="{DynamicResource Muted}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="4"
                                        Content="Select Application"
                                        Click="SelectAutoProfileApplication_Click"
                                        Margin="12,0,0,0"/>
                            </Grid>

                            <ScrollViewer Grid.Row="4"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AutoProfileMappingsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="RUNNING APPS"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="Suggestions"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Refresh"
                                        Click="RefreshRunningApps_Click"
                                        VerticalAlignment="Center"
                                        Margin="0"/>
                            </Grid>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="RunningAppsPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="ZmkTab" Header="ZMK Studio">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource Card2}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="18" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ZMK Studio"
                                           FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Name="ZmkStatus"
                                           Text="Embedded zmk.studio"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Reload" Click="ReloadZmk_Click"/>
                                <Button Content="Open in Edge"
                                        Click="OpenZmkExternal_Click" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="White"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="18"
                            ClipToBounds="True">
                        <wv2:WebView2 x:Name="ZmkWebView"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="SETTINGS"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"/>
                            <TextBlock Text="Appearance &amp; device"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Margin="0,7,0,22"/>

                            <TextBlock Text="Language"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="LanguageCombo"
                                      SelectionChanged="LanguageCombo_SelectionChanged"
                                      Margin="0,0,0,18">
                                <ComboBoxItem Content="EN  English" Tag="en" IsSelected="True"/>
                                <ComboBoxItem Content="VI  Tiếng Việt" Tag="vi"/>
                            </ComboBox>

                            <TextBlock Text="Appearance"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,0,0,6"/>
                            <Button x:Name="ThemeButton"
                                    Content="Light mode"
                                    Click="ThemeButton_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,22"/>

                            <Border Height="1"
                                    Background="{DynamicResource Line}"
                                    Margin="0,0,0,18"/>

                            <TextBlock Text="VERSION"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LumiPad App"/>
                                <TextBlock x:Name="AppVersionText"
                                           Grid.Column="1"
                                           Text="--"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Firmware"/>
                                <TextBlock x:Name="FirmwareVersionText"
                                           Grid.Column="1"
                                           Text="--"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connection"/>
                                <TextBlock x:Name="ConnectionInfoText"
                                           Grid.Column="1"
                                           Text="Disconnected"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>

                            <Border Background="{DynamicResource Card2}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DeviceDot"
                                                     Width="9" Height="9"
                                                     Fill="#66666A"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                            <TextBlock x:Name="DeviceStatus"
                                                       Text="Not connected"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="BottomStatus"
                                                   Text="Auto connect · USB first · Bluetooth fallback"
                                                   Foreground="{DynamicResource Muted}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="17,4,8,0"/>
                                    </StackPanel>

                                    <Button x:Name="DisconnectButton"
                                            Grid.Column="1"
                                            Width="38" Height="38"
                                            Padding="7"
                                            ToolTip="Disconnect"
                                            Click="DisconnectButton_Click"
                                            IsEnabled="False"
                                            Margin="8,0,0,0">
                                        <Viewbox Width="20" Height="20">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{DynamicResource TextPrimary}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M8,8 L5,5 M16,16 L19,19 M9,15 L7,17 C5,19 3,19 2,18 C1,17 1,15 3,13 L6,10 M15,9 L17,7 C19,5 21,5 22,6 C23,7 23,9 21,11 L18,14"/>
                                                <Path Stroke="{DynamicResource TextPrimary}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      Data="M8,16 L16,8"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Height="1"
                                    Background="{DynamicResource Line}"
                                    Margin="0,18,0,16"/>

                            <TextBlock Text="SYSTEM"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Flash usage"/>
                                <TextBlock x:Name="FlashUsageText"
                                           Grid.Column="1"
                                           Text="FLASH --"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM usage"/>
                                <TextBlock x:Name="RamUsageText"
                                           Grid.Column="1"
                                           Text="RAM --"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Margin="0,16,0,0">
                                <Button x:Name="RestartKeyboardButton"
                                        Content="Restart keyboard"
                                        Click="RestartKeyboard_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="KeyboardDfuButton"
                                        Content="Keyboard DFU"
                                        Click="KeyboardDfu_Click"
                                        IsEnabled="False"
                                        Margin="0"/>
                            </StackPanel>

                            <Border Height="1"
                                    Background="{DynamicResource Line}"
                                    Margin="0,18,0,16"/>

                            <TextBlock Text="DISPLAY"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"/>
                            <TextBlock Text="Panel timing"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,5,0,8"/>
                            <Border Background="{DynamicResource ControlBg}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10">
                                <TextBlock x:Name="PanelInfoText"
                                           Text="ST7789 · ~60 Hz default · SPI 32 MHz · GIF max 25 FPS"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="DIAGNOSTIC LOG"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,16,0,0"/>
                            <TextBlock Text="App + firmware events and errors"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ViewLogButton"
                                        Content="View log"
                                        Click="ToggleLog_Click"/>
                                <Button Content="Save log"
                                        Click="SaveLog_Click"
                                        Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="24"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="ACTION / SCRIPT ENGINE"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text="Actions"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="{DynamicResource Card2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Scripts"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>

                                        <ListBox x:Name="ActionScriptsList"
                                                 Grid.Row="2"
                                                 SelectionChanged="ActionScriptsList_SelectionChanged"/>

                                        <StackPanel Grid.Row="4"
                                                    Orientation="Horizontal">
                                            <Button Content="New"
                                                    Click="NewActionScript_Click"/>
                                            <Button Content="Delete"
                                                    Click="DeleteActionScript_Click"
                                                    Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource Card2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="SCRIPT EDITOR"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Muted}"/>
                                            <TextBlock x:Name="ActionEditorTitle"
                                                       Text="Select or create a script"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Name"
                                                       VerticalAlignment="Center"/>
                                            <TextBox x:Name="ActionScriptNameText"
                                                     Grid.Column="1"
                                                     TextChanged="ActionScriptNameText_TextChanged"/>
                                        </Grid>

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="ActionStepTypeCombo"
                                                      SelectedValuePath="Tag">
                                                <ComboBoxItem Content="Run app/file/URL" Tag="Run" IsSelected="True"/>
                                                <ComboBoxItem Content="Key combination" Tag="Keys"/>
                                                <ComboBoxItem Content="Type text" Tag="Text"/>
                                                <ComboBoxItem Content="Delay (ms)" Tag="Delay"/>
                                                <ComboBoxItem Content="Media key" Tag="Media"/>
                                            </ComboBox>

                                            <TextBox x:Name="ActionStepValueText"
                                                     Grid.Column="2"
                                                     ToolTip="Examples: C:\Apps\app.exe, Ctrl+Shift+S, Hello, 500, PlayPause"/>

                                            <Button Grid.Column="3"
                                                    Content="Add Step"
                                                    Click="AddActionStep_Click"
                                                    Margin="10,0,0,0"/>
                                        </Grid>

                                        <ListBox x:Name="ActionStepsList"
                                                 Grid.Row="6"/>

                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Remove Step"
                                                        Click="RemoveActionStep_Click"/>
                                                <Button Content="Move Up"
                                                        Click="MoveActionStepUp_Click"/>
                                                <Button Content="Move Down"
                                                        Click="MoveActionStepDown_Click"
                                                        Margin="0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal">
                                                <TextBlock x:Name="ActionScriptStatusText"
                                                           Text="Ready"
                                                           Foreground="{DynamicResource Muted}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>
                                                <Button Content="Save"
                                                        Click="SaveActionScript_Click"/>
                                                <Button Content="Run Test"
                                                        Click="RunActionScript_Click"
                                                        Margin="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>


    </Grid>
</Window>
